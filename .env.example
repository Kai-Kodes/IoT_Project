# P_311 Configuration Environment Variables

# MQTT Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_TELEMETRY_TOPIC_SUB=p311/machine/+/telemetry
MQTT_COMMAND_TOPIC_PREFIX=p311/machine
MQTT_STATUS_TOPIC_PREFIX=p311/machine
MQTT_FAULT_TOPIC_PREFIX=p311/machine

# Database Settings
USE_POSTGRES=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=p311_iot
POSTGRES_USER=p311_admin
POSTGRES_PASSWORD=p311_industrial_secret
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
DATABASE_PATH=data/p311.db
TELEMETRY_RETENTION_LIMIT=10000

# Grafana Settings
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3000

# Local LLM (Ollama) Settings
# Recommended: qwen2.5:1.5b (1.5GB VRAM) or qwen2.5:3b (2.6GB VRAM)
LLM_MODEL=qwen2.5:1.5b
LLM_BASE_URL=http://localhost:11434
LLM_NUM_CTX=2048
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=8.0

# RAG & Embedding Settings
# all-MiniLM-L6-v2 runs locally on CPU (~80MB model, 384 dimensions)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=data/vector_store
KNOWLEDGE_BASE_DIR=knowledge_base
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.35

# Machine Simulation Defaults
DEFAULT_MACHINE_ID=MOTOR-001
SIMULATOR_PUBLISH_INTERVAL=1.0
SIMULATOR_AUTOSTART=true
